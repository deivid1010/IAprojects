# Copia este archivo a .env para correr el backend fuera de Docker (npm run dev).
# Dentro de docker compose estas variables las define docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
MONGO_URL=mongodb://localhost:27017
MONGO_DB=clinic_assistant

CLINIC_TIMEZONE=America/Bogota

# Clínica a la que van los mensajes sin waba_id (la prueba usa una sola clínica).
DEFAULT_CLINIC_ID=clinica-vida-sana

# Cola: ElasticMQ en local (emula SQS). En AWS se deja SQS_ENDPOINT vacío.
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324
INCOMING_QUEUE_NAME=incoming-messages.fifo

# Worker
WORKER_MAX_ATTEMPTS=3
ENGINE_TIMEOUT_MS=30000

# Motor del asistente: openai (LLM real) o stub (sin LLM)
ASSISTANT_ENGINE=openai
ASSISTANT_MAX_TOOL_ITERATIONS=6
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1000
# Opcional: la API key también se puede configurar desde el panel (Configuración → Modelo de IA).
OPENAI_API_KEY=

# RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.3

# Clave maestra (32 bytes en base64) para cifrar las API keys que se guardan desde el panel.
# Genérala con: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
